{
  "$description": "Fonte única de verdade do design system AlertaCidade. Edite aqui e rode `npm run tokens:build`.",
  "color": {
    "brand": {
      "primary": "#0754B8",
      "primaryDark": "#063B82",
      "primaryLight": "#E8F2FF",
      "onPrimary": "#FFFFFF"
    },
    "neutral": {
      "background": "#F5F7FB",
      "surface": "#FFFFFF",
      "surfaceMuted": "#EEF2F7",
      "textPrimary": "#111827",
      "textSecondary": "#5B6476",
      "textDisabled": "#98A2B3",
      "border": "#DCE3ED",
      "borderStrong": "#B8C3D4",
      "overlay": "#0B1220"
    },
    "feedback": {
      "success": "#15803D",
      "warning": "#B45309",
      "error": "#B42318",
      "info": "#0754B8"
    },
    "severity": {
      "LOW": { "label": "Baixa", "base": "#16A34A", "marker": "#16A34A", "bg": "#DCFCE7", "fg": "#166534" },
      "MODERATE": { "label": "Moderada", "base": "#F59E0B", "marker": "#D97706", "bg": "#FEF3C7", "fg": "#92400E" },
      "HIGH": { "label": "Alta", "base": "#EF4444", "marker": "#DC2626", "bg": "#FEE2E2", "fg": "#B91C1C" },
      "CRITICAL": { "label": "Crítica", "base": "#991B1B", "marker": "#991B1B", "bg": "#991B1B", "fg": "#FFFFFF" }
    },
    "status": {
      "PENDING": { "label": "Pendente", "base": "#EAB308", "bg": "#FEF9C3", "fg": "#854D0E", "icon": "schedule" },
      "UNDER_REVIEW": { "label": "Em análise", "base": "#0754B8", "bg": "#E8F2FF", "fg": "#063B82", "icon": "manage_search" },
      "VALIDATED": { "label": "Validada", "base": "#0E7490", "bg": "#CFFAFE", "fg": "#155E75", "icon": "verified" },
      "REJECTED": { "label": "Rejeitada", "base": "#667085", "bg": "#F2F4F7", "fg": "#344054", "icon": "block" },
      "RESOLVED": { "label": "Resolvida", "base": "#15803D", "bg": "#DCFCE7", "fg": "#14532D", "icon": "task_alt" }
    }
  },
  "typography": {
    "fontFamily": "Inter",
    "fontFallback": ["Roboto", "Segoe UI", "system-ui", "sans-serif"],
    "scale": {
      "kpi": { "size": 32, "lineHeight": 40, "weight": 700 },
      "headline": { "size": 26, "lineHeight": 34, "weight": 700 },
      "title": { "size": 20, "lineHeight": 28, "weight": 600 },
      "subtitle": { "size": 16, "lineHeight": 24, "weight": 600 },
      "body": { "size": 15, "lineHeight": 22, "weight": 400 },
      "bodyStrong": { "size": 15, "lineHeight": 22, "weight": 600 },
      "label": { "size": 14, "lineHeight": 20, "weight": 500 },
      "caption": { "size": 12, "lineHeight": 16, "weight": 500 }
    }
  },
  "spacing": { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "elevation": {
    "card": "0 1px 2px rgba(16, 24, 40, 0.06), 0 1px 3px rgba(16, 24, 40, 0.10)",
    "raised": "0 4px 8px -2px rgba(16, 24, 40, 0.10), 0 2px 4px -2px rgba(16, 24, 40, 0.06)",
    "overlay": "0 12px 16px -4px rgba(16, 24, 40, 0.12), 0 4px 6px -2px rgba(16, 24, 40, 0.05)"
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "layout": {
    "minTouchTarget": 48,
    "screenGutter": 16,
    "adminSidebarWidth": 248,
    "adminContentMaxWidth": 1440
  }
}
