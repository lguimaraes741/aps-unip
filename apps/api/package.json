{
  "name": "@alertacidade/api",
  "version": "2.0.0",
  "private": true,
  "description": "API NestJS do AlertaCidade",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:check-drift": "dotenv -e ../../.env -- node prisma/check-drift.mjs",
    "test:unit": "jest",
    "test:int": "jest -c jest.int.config.js --runInBand",
    "test": "npm run test:unit && npm run test:int",
    "test:int:deploy": "jest -c jest.int.config.js --runInBand --globalSetup=./test/global-setup-deploy.ts"
  },
  "dependencies": {
    "@alertacidade/shared-types": "2.0.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/platform-socket.io": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@nestjs/websockets": "11.2.11",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.45.2",
    "bullmq": "5.81.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.11",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "dotenv": "17.4.2",
    "dotenv-cli": "11.1.0",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
