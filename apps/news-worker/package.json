{
  "name": "@alertacidade/news-worker",
  "version": "2.0.0",
  "private": true,
  "description": "News Intelligence: coleta notícias de fontes permitidas, analisa (regras + NLP), agrupa em eventos e decide a publicação de alertas",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:unit": "jest",
    "eval": "tsx src/evaluation/report.ts",
    "test:int": "jest -c jest.int.config.js --runInBand",
    "seed-sources": "dotenv -e ../../.env -- tsx src/tools/seed-sources.ts",
    "collect-once": "dotenv -e ../../.env -- tsx src/tools/collect-once.ts",
    "build-events": "dotenv -e ../../.env -- tsx src/tools/build-events.ts",
    "start": "node dist/main.js",
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "reprocess-failed": "dotenv -e ../../.env -- tsx src/tools/reprocess-failed.ts",
    "collect-now": "dotenv -e ../../.env -- tsx src/tools/collect-now.ts",
    "e2e-chain": "tsx src/tools/e2e-chain.ts",
    "snapshot-feeds": "dotenv -e ../../.env -- tsx src/tools/snapshot-feeds.ts",
    "eval-real": "tsx src/evaluation/real.ts"
  },
  "dependencies": {
    "@alertacidade/shared-types": "2.0.0",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.6",
    "fast-xml-parser": "5.12.1",
    "ioredis": "5.11.1",
    "undici": "7.30.2"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "dotenv": "17.4.2",
    "dotenv-cli": "11.1.0",
    "jest": "29.7.0",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
