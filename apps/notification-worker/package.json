{
  "name": "@alertacidade/notification-worker",
  "version": "2.0.0",
  "private": true,
  "description": "Worker de notificações: consome eventos do outbox (BullMQ), calcula destinatários (PostGIS) e envia push (FCM)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "test:unit": "jest",
    "test:int": "jest -c jest.int.config.js --runInBand"
  },
  "devDependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "dotenv": "17.4.2",
    "dotenv-cli": "11.1.0",
    "jest": "29.7.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@alertacidade/shared-types": "2.0.0",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-emitter": "5.1.0",
    "bullmq": "5.81.6",
    "firebase-admin": "14.5.1",
    "ioredis": "5.11.1"
  }
}
