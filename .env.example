# =============================================================
# AlertaCidade — variáveis de ambiente (copie para .env)
#   cp .env.example .env        (Git Bash)
#   Copy-Item .env.example .env (PowerShell)
# Nunca versione o arquivo .env.
# =============================================================

NODE_ENV=development
# development | demo | production  — "demo" exibe o selo de ambiente de demonstração
APP_ENV=development

# ---------- PostgreSQL / PostGIS ----------
POSTGRES_USER=alertacidade
POSTGRES_PASSWORD=alertacidade_local_dev
POSTGRES_DB=alertacidade
POSTGRES_PORT=5432
DATABASE_URL=postgresql://alertacidade:alertacidade_local_dev@localhost:5432/alertacidade?schema=public
# Banco isolado usado pelos testes de integração (criado automaticamente pelo Docker)
TEST_DATABASE_URL=postgresql://alertacidade:alertacidade_local_dev@localhost:5432/alertacidade_test?schema=public
# Banco "sombra" usado apenas para verificar drift entre schema.prisma e migrations
SHADOW_DATABASE_URL=postgresql://alertacidade:alertacidade_local_dev@localhost:5432/alertacidade_shadow?schema=public

# ---------- Redis (Fase 4: BullMQ / Socket.IO adapter) ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Intervalo do publicador do outbox quando não há eventos pendentes (ms)
OUTBOX_POLL_MS=500
# Prefixo das filas e canais no Redis (API e worker precisam usar o mesmo)
REDIS_PREFIX=alertacidade

# ---------- Worker de notificações (Fase 4) ----------
WORKER_CONCURRENCY=5
PUSH_ATTEMPTS=6
# JSON da conta de serviço do Firebase. Vazio = provedor de log (desenvolvimento, nada é entregue).
FIREBASE_CREDENTIALS_FILE=

# ---------- News Intelligence (Fase 7) — apps/news-worker ----------
# `npm run news:dev`. Usa DATABASE_URL, REDIS_URL e REDIS_PREFIX acima (o mesmo prefixo da API).
NEWS_COLLECT_CONCURRENCY=2
NEWS_ANALYZE_CONCURRENCY=4
# Tentativas de análise antes de marcar o artigo como FAILED (reprocessar: npm run news:reprocess-failed)
NEWS_ANALYZE_ATTEMPTS=5
# Tempo máximo por requisição a uma fonte (inclui conexão; o GDELT leva ~11 s para conectar)
NEWS_HTTP_TIMEOUT_MS=30000
# Conferência dos agendadores com news_sources e manutenção (eventos desatualizados, artigos órfãos)
NEWS_SCHEDULER_SYNC_MS=300000
NEWS_MAINTENANCE_MS=900000

# ---------- API ----------
API_PORT=3000
# Origens permitidas (separadas por vírgula). Nunca use "*" em produção.
CORS_ORIGINS=http://localhost:5173

# ---------- Autenticação (Fase 2) ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---------- Uploads e limites ----------
# Pasta das fotos (relativa a apps/api). Em produção, usar armazenamento de objetos.
STORAGE_DIR=./storage
# Requisições por minuto por IP (geral) e nas rotas de autenticação
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# ---------- Dados de demonstração (seed) ----------
# Senha comum aos usuários de demonstração. O seed recusa executar com APP_ENV=production.
DEMO_USER_PASSWORD=Demo@2026!
